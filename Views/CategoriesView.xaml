<UserControl x:Class="Semana04NeptunoWpf.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lista de categorías" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Datos obtenidos desde usp_ListarCategorias con DataReader." FontSize="13" Foreground="#68706A" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar lista" Click="RefreshButton_Click" Background="#B7E800" BorderBrush="#B7E800" FontWeight="SemiBold" Padding="18,10"/>
        </Grid>
        <DataGrid x:Name="CategoriesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="36" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdCategoria}" Width="80"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="190"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="90"/>
                <DataGridTextColumn Header="Código" Binding="{Binding CodCategoria}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" Foreground="#68706A" Margin="0,18,0,0"/>
    </Grid>
</UserControl>
