<UserControl x:Class="Semana04NeptunoWpf.Views.ProviderFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8F5">
 <ScrollViewer Padding="25"><StackPanel>
  <TextBlock x:Name="TitleText" Text="Nuevo proveedor" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
  <TextBlock x:Name="ValidationText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <UniformGrid Columns="2">
   <StackPanel Margin="5"><TextBlock Text="Nombre compañía *"/><TextBox x:Name="CompanyBox" MaxLength="40"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Nombre contacto *"/><TextBox x:Name="ContactBox" MaxLength="30"/></StackPanel>
   <StackPanel Margin="5"><TextBlock Text="Cargo contacto"/><TextBox x:Name="RoleBox" MaxLength="30"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Dirección"/><TextBox x:Name="AddressBox" MaxLength="60"/></StackPanel>
   <StackPanel Margin="5"><TextBlock Text="Ciudad"/><TextBox x:Name="CityBox" MaxLength="15"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Región"/><TextBox x:Name="RegionBox" MaxLength="15"/></StackPanel>
   <StackPanel Margin="5"><TextBlock Text="Código postal"/><TextBox x:Name="PostalBox" MaxLength="10"/></StackPanel><StackPanel Margin="5"><TextBlock Text="País"/><TextBox x:Name="CountryBox" MaxLength="15"/></StackPanel>
   <StackPanel Margin="5"><TextBlock Text="Teléfono"/><TextBox x:Name="PhoneBox" MaxLength="24"/></StackPanel><StackPanel Margin="5"><TextBlock Text="Fax"/><TextBox x:Name="FaxBox" MaxLength="24"/></StackPanel>
   <StackPanel Margin="5"><TextBlock Text="Página principal"/><TextBox x:Name="WebBox" MaxLength="200"/></StackPanel>
  </UniformGrid>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Guardar" Click="SaveButton_Click" Background="#B7E800" Padding="25,10" Margin="5"/><Button Content="Cancelar" Click="CancelButton_Click" Padding="25,10" Margin="5"/></StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
