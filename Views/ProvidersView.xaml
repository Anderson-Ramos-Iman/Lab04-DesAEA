<UserControl x:Class="Semana04NeptunoWpf.Views.ProvidersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lista de proveedores" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Datos obtenidos desde usp_ListarProveedores con DataReader." FontSize="13" Foreground="#68706A" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar lista" Click="RefreshButton_Click" Background="#B7E800" BorderBrush="#B7E800" FontWeight="SemiBold" Padding="18,10"/>
        </Grid>
        <DataGrid x:Name="ProvidersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="36" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdProveedor}" Width="60"/>
                <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompania}" Width="*"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="150"/>
                <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="140"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="110"/>
                <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="100"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" Foreground="#68706A" Margin="0,18,0,0"/>
    </Grid>
</UserControl>
