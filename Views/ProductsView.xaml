<UserControl x:Class="Semana04NeptunoWpf.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lista de productos" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Datos obtenidos desde usp_ListarProductos con DataReader." FontSize="13" Foreground="#68706A" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar lista" Click="RefreshButton_Click" Background="#B7E800" BorderBrush="#B7E800" FontWeight="SemiBold" Padding="18,10"/>
        </Grid>
        <DataGrid x:Name="ProductsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="36" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="70"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="90"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaProducto}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" Foreground="#68706A" Margin="0,18,0,0"/>
    </Grid>
</UserControl>
