<Window x:Class="Semana04NeptunoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Semana 04 - Neptuno" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F7F8F5">
    <Window.Resources>
        <Style x:Key="SideMenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1D1D1D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E9FFC1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#B7E800">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="24,28,24,24">
                    <TextBlock Text="Laboratirio 04" FontSize="25" FontWeight="Bold" Foreground="#1D1D1D" Margin="0,7,0,0"/>
                    <TextBlock Text="Neptuno" FontSize="13" Foreground="#4A5C00" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock Text="Menú" FontSize="11" FontWeight="Bold" Foreground="#4A5C00" Margin="32,8,0,8"/>
                    <Button Style="{StaticResource SideMenuButton}" Content="Productos" Click="ProductsButton_Click"/>
                    <Button Style="{StaticResource SideMenuButton}" Content="Categorías" Click="CategoriesButton_Click"/>
                    <Button Style="{StaticResource SideMenuButton}" Content="Proveedores" Click="ProviderSearchButton_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Desarrollo de Aplicaciones Empresariales" TextWrapping="Wrap" FontSize="11" Foreground="#4A5C00" Margin="24,20"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="Panel principal" FontSize="28" FontWeight="Bold" Foreground="#1D1D1D"/>
                <TextBlock x:Name="PageSubtitle" Text="Seleccione una opción del menú lateral para comenzar." FontSize="14" Foreground="#68706A" Margin="0,6,0,22"/>
            </StackPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="25">
                <Grid>
                    <ContentControl x:Name="ContentArea"/>
                    <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Bienvenido" FontSize="30" FontWeight="Bold" Foreground="#1D1D1D" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elija una consulta para visualizar sus datos." Foreground="#68706A" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
